# ==============================================================================
# UberClone — Versión Conductor (Environment Variables Template)
# ==============================================================================
# IMPORTANTE: Copia este archivo como .env y completa los valores correspondientes.
# NUNCA incluyas claves secretas (secret keys, tokens privados) en la app móvil.
# ==============================================================================

# ------------------------------------------------------------------------------
# Google APIs (Maps, Directions, Geocoding)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ------------------------------------------------------------------------------
# Cloudinary (Subida de fotos de perfil, vehículo y documentos)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

# ------------------------------------------------------------------------------
# Backend API (Node.js / Express para pagos y viajes)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# ------------------------------------------------------------------------------
# Pasarelas de Pago (Claves públicas para SDK móvil en modo prueba)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
EXPO_PUBLIC_MERCADOPAGO_PUBLIC_KEY=TEST-your_mercadopago_public_key
